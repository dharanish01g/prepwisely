{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "prepwisely",
  "version": "0.1.23",
  "identifier": "in.prepwisely.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "prepwisely",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0QzgyMkVBNDgzODFFNTkKUldSWkhqaEk2aUxJOUU0UmdJaTd1ZnlGeDZleDl5RzcyNXhqcStKZjg0bUN0SFhBTWtRTWJUT2oK",
      "endpoints": [
        "https://github.com/dharanish01g/prepwisely/releases/latest/download/latest.json"
      ]
    }
  }
}
